# Copiar a .env (no se sube a git) y cambiar los valores.

# Postgres (una base por servicio en el mismo servidor)
DB_USERNAME=cambiar_usuario
DB_PASSWORD=cambiar_clave
# Puerto de Postgres desde tu maquina (5434 para no chocar con el del monolito)
DB_HOST_PORT=5434

# RabbitMQ (topics STOMP)
RABBIT_USUARIO=cambiar_usuario
RABBIT_CLAVE=cambiar_clave

# Redis (estado vivo compartido)
REDIS_CLAVE=cambiar_clave

# Partida: 5 s de aviso en el front + 20 s de juego
RETO_DURACION=25s

# Desde donde puede llamar el front (separados por coma)
CORS_ORIGENES=http://localhost:5173

# Puerto del gateway desde tu maquina (el front con Vite apunta a 8080)
GATEWAY_PORT=8080
